# ─── Base de datos ───────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:password@localhost:5432/marketing_db

# ─── JWT ──────────────────────────────────────────────────────────────────────
SECRET_KEY=your-super-secret-key-change-in-production-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# ─── Aplicación ───────────────────────────────────────────────────────────────
APP_NAME=Marketing Project Manager
APP_ENV=development
FRONTEND_URL=http://localhost:3000

# ─── Email (SMTP) ─────────────────────────────────────────────────────────────
MAIL_USERNAME=tu_correo@gmail.com
MAIL_PASSWORD=tu_app_password
MAIL_FROM=tu_correo@gmail.com
MAIL_PORT=587
MAIL_SERVER=smtp.gmail.com
MAIL_FROM_NAME=Marketing Project Manager
MAIL_TLS=True
MAIL_SSL=False

# ─── Upload ───────────────────────────────────────────────────────────────────
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=20
